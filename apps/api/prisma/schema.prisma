generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  username String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile Profile?
  refreshSessions RefreshSession[]
  systems RpgSystem[]
  campaigns Campaign[]
  campaignMemberships CampaignMember[]
  sentInvitations CampaignInvitation[] @relation("Inviter")
  receivedInvitations CampaignInvitation[] @relation("Recipient")
  characters Character[]
}

model Profile {
  userId String @id
  displayName String
  bio String @default("")
  location String @default("")
  avatarKey String?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id String @id @default(uuid())
  userId String
  familyId String
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([familyId])
}

enum SystemVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model RpgSystem {
  id String @id @default(uuid())
  ownerId String
  name String
  description String @default("")
  visibility SystemVisibility @default(PRIVATE)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions SystemVersion[]
  @@index([ownerId, updatedAt])
  @@index([visibility, updatedAt])
}

model SystemVersion {
  id String @id @default(uuid())
  systemId String
  number Int
  name String
  description String
  definition Json
  createdAt DateTime @default(now())
  system RpgSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  characters Character[]
  @@unique([systemId, number])
}

enum CampaignVisibility {
  PRIVATE
  PUBLIC
}

enum CampaignStatus {
  PLANNED
  RECRUITING
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

model Campaign {
  id String @id @default(uuid())
  ownerId String
  systemVersionId String
  name String
  description String @default("")
  visibility CampaignVisibility @default(PRIVATE)
  status CampaignStatus @default(PLANNED)
  maxPlayers Int
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  systemVersion SystemVersion @relation(fields: [systemVersionId], references: [id], onDelete: NoAction)
  changes CampaignChange[]
  members CampaignMember[]
  invitations CampaignInvitation[]
  characters Character[]
  @@unique([id, systemVersionId])
  sessions GameSession[]
  @@index([ownerId, updatedAt])
  @@index([visibility, updatedAt])
  @@index([systemVersionId])
}

model CampaignChange {
  id String @id @default(uuid())
  campaignId String
  revision Int
  actorId String
  snapshot Json
  createdAt DateTime @default(now())
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@unique([campaignId, revision])
}

enum CampaignMemberStatus {
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

model CampaignMember {
  id String @id @default(uuid())
  campaignId String
  userId String
  status CampaignMemberStatus @default(ACTIVE)
  joinedAt DateTime @default(now())
  removedAt DateTime?
  updatedAt DateTime @updatedAt
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([campaignId, userId])
  @@index([userId, status])
  @@index([campaignId, status])
}

model CampaignInvitation {
  id String @id @default(uuid())
  campaignId String
  inviterId String
  recipientId String
  status InvitationStatus @default(PENDING)
  createdAt DateTime @default(now())
  expiresAt DateTime
  respondedAt DateTime?
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inviter User @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  recipient User @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([recipientId, createdAt])
  @@index([campaignId, createdAt])
}

model Character {
  id String @id @default(uuid())
  ownerId String
  campaignId String
  systemVersionId String
  name String
  description String @default("")
  story String @default("")
  level Int?
  values Json
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId, systemVersionId], references: [id, systemVersionId], onDelete: Cascade)
  systemVersion SystemVersion @relation(fields: [systemVersionId], references: [id], onDelete: NoAction)
  changes CharacterChange[]
  @@index([ownerId, updatedAt])
  @@index([campaignId, updatedAt])
  @@index([systemVersionId])
}

model CharacterChange {
  id String @id @default(uuid())
  characterId String
  actorId String
  revision Int
  snapshot Json
  createdAt DateTime @default(now())
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([characterId, revision])
}

enum GameSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model GameSession {
  id String @id @default(uuid())
  campaignId String
  title String
  description String @default("")
  scheduledAt DateTime
  timeZone String
  visibility CampaignVisibility @default(PRIVATE)
  status GameSessionStatus @default(SCHEDULED)
  revision Int @default(1)
  startedAt DateTime?
  endedAt DateTime?
  cancelledAt DateTime?
  durationSeconds Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  changes GameSessionChange[]
  @@index([campaignId, scheduledAt])
  @@index([status, visibility, startedAt])
}

model GameSessionChange {
  id String @id @default(uuid())
  sessionId String
  actorId String
  revision Int
  snapshot Json
  createdAt DateTime @default(now())
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, revision])
}
